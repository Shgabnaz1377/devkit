{
  "name": "devkit",
  "version": "0.1.0",
  "private": true,
  "description": "A fast, privacy-first toolbox for developers. Everything runs locally in your browser.",
  "license": "MIT",
  "author": "Shabnaz Ghaffari",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
